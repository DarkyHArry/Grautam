{
  "name": "grautam-desktop",
  "version": "1.3.0",
  "description": "Central de operações e viagens Grautam",
  "main": "src/main.js",
  "author": "Grautam",
  "license": "UNLICENSED",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node tests/run-tests.js",
    "dist": "electron-builder"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "electron-store": "^10.0.1",
    "lucide-static": "^0.577.0"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.grautam.desktop",
    "productName": "Grautam",
    "artifactName": "Grautam Setup.${ext}",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      { "from": "assets", "to": "assets" }
    ],
    "win": {
      "icon": "assets/grautam.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
